# Healthcare Application - Production Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS

# ============================================
# SECURITY & AUTHENTICATION
# ============================================
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHAR_SECRET
API_KEY=CHANGE_ME_GENERATE_RANDOM_KEY
ENCRYPTION_SALT=CHANGE_ME_GENERATE_RANDOM_SALT

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
NODE_ENV=production
LOG_LEVEL=info

# ============================================
# NETWORK & DOMAIN
# ============================================
# Update these with your actual domain
API_GATEWAY_URL=ec2-13-232-251-83.ap-south-1.compute.amazonaws.com
FRONTEND_URL=ec2-13-232-251-83.ap-south-1.compute.amazonaws.com
ALLOWED_ORIGINS=ec2-13-232-251-83.ap-south-1.compute.amazonaws.com

# ============================================
# DYNAMODB (AWS or Local)
# ============================================
DYNAMO_ENDPOINT=http://dynamodb:8000
DYNAMO_AWS_REGION=us-east-1

# ============================================
# gRPC SERVICES (Internal Docker Network)
# ============================================
USER_SERVICE_HOST=user-service
USER_SERVICE_PORT=50051
DOCTOR_SERVICE_HOST=doctor-service
DOCTOR_SERVICE_PORT=50051
APPOINTMENT_SERVICE_HOST=appointment-service
APPOINTMENT_SERVICE_PORT=50051
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=50051

# ============================================
# SESSION CONFIGURATION
# ============================================
SESSION_DURATION=3600000

# ============================================
# AWS (If using RDS or Secrets Manager)
# ============================================
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=YOUR_AWS_ACCOUNT_ID
# RDS_ENDPOINT=healthcare-db.xxxxx.us-east-1.rds.amazonaws.com

# ============================================
# MONITORING & LOGGING
# ============================================
# CloudWatch or external logging service
# LOG_GROUP=/healthcare/api-gateway
# LOG_STREAM=production
